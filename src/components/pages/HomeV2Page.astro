---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoCodeFlowShowcase from '../widgets/NoCodeFlowShowcase.astro';
import { SITE_CONTENT, ROUTES, T3ELEMENT_LINKS, MERGED_FAQS, type Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const content = SITE_CONTENT[locale];
const routes = ROUTES[locale];
const isDe = locale === 'de';

const workflowSteps = [
  {
    num: '01',
    title: 'Create Custom & Container Elements in TYPO3',
    badge: 'NO CODING REQUIRED',
    path: 'Web > T3headless > Elements',
    summary:
      'Use the 3-tab visual wizard (Info, Fields, Template) inside TYPO3. Drag and drop String, Text, File, Link, or Repeating fields for sliders and accordions, or add multi-column Container layouts with "+ Add Column".',
    highlights: ['Custom Elements & Container Columns', 'Repeating Field Groups for Sliders & FAQs', 'Zero TCA, TypoScript, or Fluid Boilerplate'],
    terminal: 'TYPO3 Backend -> + Create New Element -> Drag Fields -> Save',
  },
  {
    num: '02',
    title: 'Auto-Generated Template & Click-to-Copy Markers',
    badge: 'SAFE VISUAL EDITING',
    path: 'Elements > Template Tab',
    summary:
      'T3Headless generates a ready-to-use React/Next.js template automatically. Need to add a new field later? Your template is never overwritten: simply click the new Field Marker to copy and paste it anywhere.',
    highlights: ['One-Click "Marker Copied!" Field Helpers', 'Built-In <Link>, <Nimage>, <All.Slider>, <All.Accordion>', 'Safe Edit & Delete Warnings When In Use'],
    terminal: 'Click Marker: {_data?.headline} -> "Marker Copied!" -> Paste',
  },
  {
    num: '03',
    title: 'Place Directly on Any TYPO3 Page',
    badge: 'NATIVE EDITOR UX',
    path: 'Web > Page > + Create new content',
    summary:
      'Editors immediately pick the newly created element from the TYPO3 content wizard, add slides or columns (like "+ Add Slide"), fill in text and media, and save inside the familiar TYPO3 page tree.',
    highlights: ['Native TYPO3 Page Tree Preserved 100%', 'Standard FAL Media & Multi-Language Support', 'Works on New or Existing Pages Instantly'],
    terminal: 'Web > Page > Normal Column > + Create new content -> Save',
  },
  {
    num: '04',
    title: 'Auto-Generated Next.js Component (Zero Frontend Code)',
    badge: 'CORE USP',
    path: 't3headless-frontend',
    summary:
      'You never need to open the Next.js codebase and hand-code rendering components. Running yarn themebuild syncs your TYPO3 elements and auto-generates the production Next.js components automatically.',
    highlights: ['0 Lines of Manual Next.js Rendering Code', 'Automatic Component & Style Generation', '100/100 Core Web Vitals & Edge SSR Ready'],
    terminal: '$ yarn themebuild  ->  ✓ Generated SliderElement.tsx & styles',
  },
  {
    num: '05',
    title: 'Manage Global Theme Options Without Deployments',
    badge: 'GLOBAL CONTROL',
    path: 'T3headless > Theme Options > Header',
    summary:
      'Upload your Logo (with custom width and height), Favicon, Custom Fonts, CSS, and JS files, or assign a global Header Page directly from the TYPO3 backend.',
    highlights: ['Logo, Favicon & Custom Dimensions', 'Custom Font, CSS & JS Uploads', 'Global Header & Footer Page Overrides'],
    terminal: 'Theme Options > Header -> Upload Logo & Fonts -> Save Changes',
  },
];

const allMergedFaqs = MERGED_FAQS[locale];
const displayedFaqs = allMergedFaqs.slice(0, 5);
---

<BaseLayout
  locale={locale}
  title={
    isDe
      ? 'T3Headless - Enterprise Headless TYPO3 CMS & T3Element Lösungen'
      : 'T3Headless - Enterprise Headless TYPO3 CMS & T3Element Solutions'
  }
  description={content.meta.description}
>
  <!-- SECTION 1: INTERACTIVE MOTION HERO -->
  <section class="w-full bg-white">
    <div class="swiss-container">
      <div class="grid grid-cols-1 lg:grid-cols-12 border-b border-[#222222]/12 relative divide-y lg:divide-y-0 lg:divide-x divide-[#222222]/12">
        <span class="crosshair crosshair--tl" aria-hidden="true"></span>
        <span class="crosshair crosshair--tc" aria-hidden="true"></span>
        <span class="crosshair crosshair--tr" aria-hidden="true"></span>
        <span class="crosshair crosshair--bl" aria-hidden="true"></span>
        <span class="crosshair crosshair--bc" aria-hidden="true"></span>
        <span class="crosshair crosshair--br" aria-hidden="true"></span>

        <!-- Left Column: Brand-New Interactive Motion Infographic -->
        <div class="lg:col-span-6 p-6 sm:p-10 lg:p-12 flex flex-col justify-center">
          <NoCodeFlowShowcase locale={locale} />
        </div>

        <!-- Right Column: Core USP Headline + Demo Form -->
        <div class="lg:col-span-6 p-6 sm:p-10 lg:p-12 flex flex-col justify-between space-y-8">
          <div class="space-y-5">
            <div class="flex flex-wrap items-center gap-2">
              <span class="uxis-pill uxis-pill-orange font-mono text-[0.72rem] uppercase tracking-wider">
                <span class="w-1.5 h-1.5 rounded-full bg-[#f7931e] animate-pulse" aria-hidden="true"></span>
                <span>NO-CODE HEADLESS TYPO3 + NEXT.JS</span>
              </span>
              <span class="px-2.5 py-1 rounded-full bg-[#222222] text-white font-mono text-[0.68rem] uppercase font-semibold">
                {isDe ? 'OFFIZIELLE LÖSUNG' : 'OFFICIAL SOLUTION'}
              </span>
            </div>

            <h1 class="display-hero text-[#222222]">
              {
                isDe
                  ? 'TYPO3-Elemente ohne Code erstellen. Automatisch in Next.js gerendert.'
                  : 'Create TYPO3 elements with zero code. Auto-generated in Next.js.'
              }
            </h1>

            <p class="text-base sm:text-[1.05rem] text-[#4e4e4e] max-w-xl leading-relaxed">
              {
                isDe
                  ? 'Erstellen Sie eigene Inhaltselemente und mehrspaltige Container visuell in TYPO3, platzieren Sie sie auf beliebigen Seiten und lassen Sie T3Headless die Next.js-Komponenten automatisch generieren.'
                  : 'Build Custom Elements and multi-column Containers visually inside TYPO3, drop them onto any page, and let T3Headless generate the Next.js component automatically. You never need to open Next.js to write rendering code.'
              }
            </p>

            <div class="flex flex-wrap gap-2 pt-1">
              <span class="uxis-pill font-mono text-[0.72rem] uppercase">TYPO3 v13 / v14 LTS</span>
              <span class="uxis-pill font-mono text-[0.72rem] uppercase">{isDe ? 'Kein Next.js-Code nötig' : 'Zero Next.js Coding'}</span>
              <span class="uxis-pill font-mono text-[0.72rem] uppercase">EXT:t3headless</span>
            </div>
          </div>

          <div class="space-y-6 pt-2">
            <!-- Inline Demo Form (CRM Wired) -->
            <form
              id="hero-v2-demo-form"
              class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2"
              data-locale={locale}
            >
              <input
                type="email"
                name="email"
                required
                placeholder={isDe ? 'Ihre geschäftliche E-Mail' : 'Your work email'}
                class="uxis-input flex-1"
              />
              <button id="hero-v2-demo-btn" type="submit" class="uxis-cta-btn shrink-0 disabled:opacity-60">
                <span id="hero-v2-demo-label">{isDe ? 'Demo anfordern' : 'Get a demo'}</span>
                <span aria-hidden="true">→</span>
              </button>
            </form>
            <p id="hero-v2-demo-msg" class="hidden font-mono text-xs text-[#222222]"></p>

            <!-- Quick Install Strip + Links -->
            <div class="pt-5 border-t border-[#222222]/12 flex flex-wrap items-center justify-between gap-4">
              <div class="flex flex-wrap items-center gap-3">
                <button
                  type="button"
                  id="v2-copy-composer"
                  class="px-3.5 py-2 rounded-full bg-[#f7f7f7] hover:bg-[#222222] text-[#222222] hover:text-white border border-[#222222]/15 font-mono text-xs inline-flex items-center gap-2 transition-all cursor-pointer active:scale-95"
                  data-cmd={T3ELEMENT_LINKS.t3headlessComposerCmd}
                >
                  <span id="v2-composer-text">{T3ELEMENT_LINKS.t3headlessComposerCmd}</span>
                  <span class="text-[#f7931e] font-bold">⧉</span>
                </button>

                <a
                  href={content.meta.calLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-mono text-[#4e4e4e] hover:text-[#222222] transition-colors inline-flex items-center gap-1.5"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-[#f7931e]"></span>
                  <span>{content.hero.consultationBadge} ↗</span>
                </a>
              </div>

              <a
                href={routes.document}
                class="uxis-underline text-sm font-semibold text-[#222222] inline-flex items-center gap-1.5"
              >
                <span>{isDe ? 'Schnellstart-Dokumentation' : 'Read Quickstart Docs'}</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: KINETIC 3-STAGE MOTION RAIL ("CREATE. PLACE. AUTO-RENDER.") -->
  <section class="w-full hairline-b bg-[#f7f7f7] py-20 lg:py-24">
    <div class="swiss-container space-y-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end" data-uxis-reveal>
        <div class="lg:col-span-7 space-y-3">
          <span class="eyebrow-label">THE NO-CODE HEADLESS WORKFLOW</span>
          <h2 class="display-section text-[#222222]">Create. Place. Auto-Render.</h2>
          <p class="text-base sm:text-lg text-[#4e4e4e] max-w-2xl leading-relaxed">
            Traditional headless setups force developers to double-build every block in the CMS and again in Next.js. T3Headless collapses both worlds into one visual TYPO3 workflow.
          </p>
        </div>
        <div class="lg:col-span-5 lg:text-right">
          <a href={T3ELEMENT_LINKS.docsGuideUrl} target="_blank" rel="noopener noreferrer" class="uxis-cta-outline">
            <span>View Full User Guide</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <!-- Animated Horizontal 3-Stage Pulse Rail -->
      <div class="relative" data-uxis-reveal>
        <div class="hidden lg:block absolute top-11 left-[12%] right-[12%] h-[2px] bg-[#222222]/12 overflow-hidden z-0">
          <div class="h-full w-1/3 bg-gradient-to-r from-transparent via-[#f7931e] to-transparent v2-rail-pulse"></div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 relative z-10">
          <div class="group rounded-2xl p-8 bg-white text-[#222222] border border-[#222222]/12 hover:border-[#f7931e] hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between gap-6 shadow-sm hover:shadow-md">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="w-10 h-10 rounded-full bg-[#f7f7f7] group-hover:bg-[#222222] group-hover:text-white border border-[#222222]/15 font-mono text-xs font-bold inline-flex items-center justify-center transition-colors">01</span>
                <span class="font-mono text-[11px] uppercase tracking-widest text-[#8c8c8c] font-semibold">CREATE IN TYPO3</span>
              </div>
              <h3 class="text-2xl font-bold tracking-tight">No-Code Element Builder</h3>
              <p class="text-sm text-[#4e4e4e] leading-relaxed">
                Define Custom Elements or multi-column Container Elements visually in TYPO3 with drag-and-drop fields and click-to-copy markers.
              </p>
            </div>
            <div class="pt-4 border-t border-[#222222]/10 flex items-center justify-between font-mono text-xs">
              <span class="text-[#8c8c8c]">CODING REQUIRED</span>
              <span class="px-3 py-1 rounded-full bg-[#f7f7f7] border border-[#d9d9d9] font-semibold">0 Lines</span>
            </div>
          </div>

          <div class="group rounded-2xl p-8 bg-[#222222] text-white border border-[#222222] hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between gap-6 shadow-lg">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="w-10 h-10 rounded-full bg-[#f7931e] text-[#222222] font-mono text-xs font-bold inline-flex items-center justify-center">02</span>
                <span class="font-mono text-[11px] uppercase tracking-widest text-[#f7931e] font-semibold">PLACE ON PAGE</span>
              </div>
              <h3 class="text-2xl font-bold tracking-tight">Native TYPO3 Page Tree</h3>
              <p class="text-sm text-white/80 leading-relaxed">
                Drop your newly created element onto any page via "+ Create new content", add slides or content, and hit Save.
              </p>
            </div>
            <div class="pt-4 border-t border-white/15 flex items-center justify-between font-mono text-xs">
              <span class="text-white/60">EDITOR WORKFLOW</span>
              <span class="px-3 py-1 rounded-full bg-white/12 text-[#f7931e] font-semibold">100% Native</span>
            </div>
          </div>

          <div class="group rounded-2xl p-8 bg-white text-[#222222] border border-[#222222]/12 hover:border-[#f7931e] hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between gap-6 shadow-sm hover:shadow-md">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="w-10 h-10 rounded-full bg-[#f7f7f7] group-hover:bg-[#222222] group-hover:text-white border border-[#222222]/15 font-mono text-xs font-bold inline-flex items-center justify-center transition-colors">03</span>
                <span class="font-mono text-[11px] uppercase tracking-widest text-[#8c8c8c] font-semibold">AUTO-RENDER</span>
              </div>
              <h3 class="text-2xl font-bold tracking-tight">Auto-Generated Next.js</h3>
              <p class="text-sm text-[#4e4e4e] leading-relaxed">
                Your Next.js component is generated automatically with built-in Nimage, Link, and All.* helpers. No manual frontend coding needed.
              </p>
            </div>
            <div class="pt-4 border-t border-[#222222]/10 flex items-center justify-between font-mono text-xs">
              <span class="text-[#8c8c8c]">NEXT.JS RENDER</span>
              <span class="px-3 py-1 rounded-full bg-[#f7931e]/15 text-[#c86a00] font-semibold">Auto-Synced</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: INTERACTIVE 5-STEP WORKFLOW EXPLORER -->
  <section class="w-full hairline-b bg-white py-20 lg:py-28">
    <div class="swiss-container space-y-12">
      <div class="max-w-3xl space-y-3" data-uxis-reveal>
        <span class="eyebrow-label">INTERACTIVE PROCESS EXPLORER</span>
        <h2 class="display-section text-[#222222]">
          Click any step to see how TYPO3 powers Next.js automatically.
        </h2>
      </div>

      <div
        id="v2-workflow-explorer"
        class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start"
        data-steps={JSON.stringify(workflowSteps)}
      >
        <!-- Left: 5 Clickable Interactive Steps -->
        <div class="lg:col-span-5 space-y-2.5">
          {
            workflowSteps.map((step, idx) => (
              <button
                type="button"
                data-wf-btn={String(idx)}
                aria-selected={idx === 0 ? 'true' : 'false'}
                class:list={[
                  'w-full text-left p-5 rounded-2xl border transition-all duration-200 flex items-start gap-4 cursor-pointer',
                  idx === 0
                    ? 'bg-[#222222] text-white border-[#222222] shadow-md'
                    : 'bg-white text-[#222222] border-[#222222]/12 hover:border-[#f7931e] hover:bg-[#f7f7f7]/60',
                ]}
              >
                <span
                  class:list={[
                    'w-9 h-9 rounded-full font-mono text-xs font-bold inline-flex items-center justify-center shrink-0 border transition-colors',
                    idx === 0
                      ? 'bg-[#f7931e] text-[#222222] border-[#f7931e]'
                      : 'bg-[#f7f7f7] text-[#222222] border-[#222222]/15',
                  ]}
                >
                  {step.num}
                </span>
                <div class="space-y-1 min-w-0">
                  <span class:list={['block font-mono text-[10px] uppercase tracking-wider', idx === 0 ? 'text-[#f7931e]' : 'text-[#8c8c8c]']}>
                    {step.badge}
                  </span>
                  <span class="block text-base font-bold leading-snug">{step.title}</span>
                </div>
              </button>
            ))
          }
        </div>

        <!-- Right: Dynamic Morphing Stage Inspector -->
        <div class="lg:col-span-7 lg:sticky lg:top-24">
          <div id="v2-wf-card" class="rounded-2xl border border-[#222222]/14 bg-[#f7f7f7] p-7 sm:p-9 space-y-6 transition-all duration-300">
            <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-[#222222]/12">
              <span id="v2-wf-badge" class="uxis-pill uxis-pill-orange font-mono text-xs font-bold">
                {workflowSteps[0].badge}
              </span>
              <span id="v2-wf-path" class="font-mono text-xs text-[#4e4e4e]">
                {workflowSteps[0].path}
              </span>
            </div>

            <div class="space-y-3">
              <h3 id="v2-wf-title" class="text-2xl sm:text-3xl font-bold text-[#222222] tracking-tight">
                {workflowSteps[0].title}
              </h3>
              <p id="v2-wf-summary" class="text-base text-[#4e4e4e] leading-relaxed">
                {workflowSteps[0].summary}
              </p>
            </div>

            <ul id="v2-wf-highlights" class="space-y-2.5 bg-white rounded-xl p-5 border border-[#222222]/10">
              {
                workflowSteps[0].highlights.map((h) => (
                  <li class="flex items-center gap-2.5 text-sm font-medium text-[#222222]">
                    <span class="w-2 h-2 rounded-full bg-[#f7931e] shrink-0"></span>
                    <span>{h}</span>
                  </li>
                ))
              }
            </ul>

            <div class="rounded-xl bg-[#222222] text-white p-4 font-mono text-xs flex items-center justify-between gap-3 overflow-x-auto">
              <code id="v2-wf-terminal" class="text-[#f7931e]">{workflowSteps[0].terminal}</code>
              <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 shrink-0">LIVE</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: INTERACTIVE THEME OPTIONS LIVE CUSTOMIZER -->
  <section class="w-full hairline-b bg-[#f7f7f7] py-20 lg:py-28">
    <div class="swiss-container space-y-10">
      <div class="max-w-3xl space-y-3" data-uxis-reveal>
        <span class="eyebrow-label">LIVE INTERACTIVE PLAYGROUND • THEME OPTIONS</span>
        <h2 class="display-section text-[#222222]">
          Control your Next.js header, logo, fonts &amp; styles from TYPO3.
        </h2>
        <p class="text-base text-[#4e4e4e]">
          Try toggling TYPO3 <strong>Theme Options &gt; Header</strong> settings below and watch the Next.js frontend preview update in real time.
        </p>
      </div>

      <div id="v2-theme-playground" class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
        <!-- Left: Interactive TYPO3 Theme Options Controls -->
        <div class="lg:col-span-5 rounded-2xl bg-white border border-[#222222]/12 p-6 sm:p-7 space-y-6">
          <div class="flex items-center justify-between pb-3 border-b border-[#222222]/10">
            <span class="font-mono text-xs font-bold uppercase text-[#222222]">TYPO3 Theme Options</span>
            <span class="font-mono text-[10px] text-[#f7931e] font-semibold">INSTANT SYNC</span>
          </div>

          <!-- Accent Color -->
          <div class="space-y-2">
            <label class="block font-mono text-xs uppercase text-[#4e4e4e]">Brand Accent Color</label>
            <div class="flex flex-wrap gap-2">
              <button type="button" data-theme-accent="#f7931e" class="px-3 py-1.5 rounded-full border border-[#222222] bg-[#222222] text-white font-mono text-xs cursor-pointer">T3 Orange</button>
              <button type="button" data-theme-accent="#222222" class="px-3 py-1.5 rounded-full border border-[#d9d9d9] bg-white text-[#222222] font-mono text-xs cursor-pointer">Obsidian</button>
              <button type="button" data-theme-accent="#059669" class="px-3 py-1.5 rounded-full border border-[#d9d9d9] bg-white text-[#222222] font-mono text-xs cursor-pointer">Emerald</button>
            </div>
          </div>

          <!-- Logo Width -->
          <div class="space-y-2">
            <label class="block font-mono text-xs uppercase text-[#4e4e4e]">Custom Logo Size</label>
            <div class="flex flex-wrap gap-2">
              <button type="button" data-theme-logo="sm" class="px-3 py-1.5 rounded-full border border-[#d9d9d9] bg-white text-[#222222] font-mono text-xs cursor-pointer">Compact</button>
              <button type="button" data-theme-logo="md" class="px-3 py-1.5 rounded-full border border-[#222222] bg-[#222222] text-white font-mono text-xs cursor-pointer">Standard</button>
              <button type="button" data-theme-logo="lg" class="px-3 py-1.5 rounded-full border border-[#d9d9d9] bg-white text-[#222222] font-mono text-xs cursor-pointer">Large</button>
            </div>
          </div>

          <!-- Header Page Override -->
          <div class="space-y-2">
            <label class="flex items-center justify-between p-3.5 rounded-xl bg-[#f7f7f7] border border-[#222222]/10 cursor-pointer">
              <div>
                <span class="block text-sm font-bold text-[#222222]">Enable Global Header Page</span>
                <span class="block font-mono text-[10px] text-[#4e4e4e]">Overrides default header with a TYPO3 page</span>
              </div>
              <input id="v2-header-page-toggle" type="checkbox" class="h-4 w-4 accent-[#f7931e] cursor-pointer" />
            </label>
          </div>
        </div>

        <!-- Right: Live Next.js Preview Frame -->
        <div class="lg:col-span-7 rounded-2xl bg-[#222222] p-5 sm:p-7 flex flex-col justify-between gap-4">
          <div class="flex items-center justify-between font-mono text-[11px] text-white/60">
            <span>NEXT.JS LIVE FRONTEND PREVIEW</span>
            <span class="text-emerald-400">● Synchronized</span>
          </div>

          <div class="rounded-xl bg-white text-[#222222] overflow-hidden border border-white/15 flex-1 flex flex-col">
            <!-- Optional Top Header Page Bar -->
            <div id="v2-preview-topbar" class="hidden px-5 py-2 bg-[#f7931e] text-[#222222] font-mono text-[11px] font-bold text-center transition-all">
              Global TYPO3 Header Page Active: Enterprise TYPO3 v13 / v14 Ready
            </div>

            <!-- Simulated Header -->
            <div class="px-6 py-4 border-b border-[#222222]/10 flex items-center justify-between gap-4">
              <div class="flex items-center gap-2.5">
                <span id="v2-preview-logo" class="px-3 py-1 rounded-lg bg-[#222222] text-white font-display font-bold text-sm transition-all duration-300">
                  YOUR BRAND
                </span>
              </div>
              <div class="flex items-center gap-4 text-xs font-medium text-[#4e4e4e]">
                <span>Products</span>
                <span>Docs</span>
                <span id="v2-preview-cta" class="px-3.5 py-1.5 rounded-full bg-[#f7931e] text-[#222222] font-bold transition-colors duration-300">
                  Contact →
                </span>
              </div>
            </div>

            <!-- Simulated Body -->
            <div class="p-6 space-y-3 my-auto">
              <span class="font-mono text-[10px] uppercase tracking-wider text-[#8c8c8c]">Auto-Generated Next.js Page</span>

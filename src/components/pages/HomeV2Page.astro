<style>
  @keyframes v2RailSweep {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(320%);
    }
  }
  .v2-rail-pulse {
    animation: v2RailSweep 2.6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  /* Workflow Step Buttons Hover Safety */
  [data-wf-btn][aria-selected="true"] {
    background-color: #222222 !important;
    color: #ffffff !important;
    border-color: #222222 !important;
  }
  [data-wf-btn][aria-selected="true"]:hover {
    background-color: #000000 !important;
    color: #ffffff !important;
    border-color: #000000 !important;
  }

  /* Theme Customizer Buttons Hover Safety */
  [data-theme-accent],
  [data-theme-logo] {
    transition: all 0.2s ease;
  }
  [data-theme-accent]:hover,
  [data-theme-logo]:hover {
    border-color: #222222;
  }
</style>

<script>
  import { requestDemo } from '../../lib/crm';

  function initHomeV2Interactions() {
    // 1. Demo Form
    const form = document.getElementById('hero-v2-demo-form') as HTMLFormElement | null;
    if (form && form.dataset.bound !== 'true') {
      form.dataset.bound = 'true';
      const msgEl = document.getElementById('hero-v2-demo-msg');
      const btn = document.getElementById('hero-v2-demo-btn') as HTMLButtonElement | null;
      const labelEl = document.getElementById('hero-v2-demo-label');

      const isDe = form.dataset.locale === 'de';
      const defaultLabel = labelEl?.textContent || (isDe ? 'Demo anfordern' : 'Get a demo');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!msgEl) return;
        msgEl.classList.add('hidden');
        msgEl.classList.remove('text-red-600');
        msgEl.classList.add('text-[#222222]');

        const fd = new FormData(form);
        const email = String(fd.get('email') || '');
        if (btn) btn.disabled = true;
        if (labelEl) labelEl.textContent = isDe ? 'Wird gesendet…' : 'Sending…';

        const result = await requestDemo(email);
        if (btn) btn.disabled = false;
        if (labelEl) labelEl.textContent = defaultLabel;

        if (result.ok) {
          msgEl.textContent =
            result.status === 'already_requested'
              ? (isDe ? '✓ Demo für diese E-Mail bereits angefordert. Unser Team meldet sich in Kürze.' : '✓ Demo already requested for this email. Our team will follow up shortly.')
              : (isDe ? '✓ Demo-Anfrage erhalten. Unser Engineering-Team meldet sich in Kürze.' : '✓ Demo request received. Our team will reply shortly.');
          if (result.status !== 'already_requested') form.reset();
          msgEl.classList.remove('hidden');
        } else {
          msgEl.textContent = `✕ ${result.error || (isDe ? 'Anfrage fehlgeschlagen. Bitte versuchen Sie es erneut.' : 'Request failed. Please try again.')}`;
          msgEl.classList.remove('text-[#222222]', 'hidden');
          msgEl.classList.add('text-red-600');
        }
      });
    }

    // 2. Copy Composer Command Button
    const copyBtn = document.getElementById('v2-copy-composer');
    const copyText = document.getElementById('v2-composer-text');
    if (copyBtn && copyBtn.dataset.bound !== 'true') {
      copyBtn.dataset.bound = 'true';
      copyBtn.addEventListener('click', () => {
        const cmd = copyBtn.dataset.cmd || 'composer require t3element/t3headless';
        navigator.clipboard?.writeText(cmd).catch(() => {});
        if (copyText) {
          copyText.textContent = '✓ Copied: ' + cmd;
          setTimeout(() => {
            copyText.textContent = cmd;
          }, 1800);
        }
      });
    }

    // 3. Interactive 5-Step Workflow Explorer
    const explorer = document.getElementById('v2-workflow-explorer');
    if (explorer && explorer.dataset.bound !== 'true') {
      explorer.dataset.bound = 'true';
      const steps = JSON.parse(explorer.dataset.steps || '[]');
      const btns = Array.from(explorer.querySelectorAll<HTMLButtonElement>('[data-wf-btn]'));
      const badgeEl = document.getElementById('v2-wf-badge');
      const pathEl = document.getElementById('v2-wf-path');
      const titleEl = document.getElementById('v2-wf-title');
      const summaryEl = document.getElementById('v2-wf-summary');
      const highlightsEl = document.getElementById('v2-wf-highlights');
      const termEl = document.getElementById('v2-wf-terminal');

      btns.forEach((b, idx) => {
        b.addEventListener('click', () => {
          const step = steps[idx];
          if (!step) return;
          btns.forEach((btn, i) => {
            const active = i === idx;
            btn.setAttribute('aria-selected', String(active));
            btn.classList.toggle('bg-[#222222]', active);
            btn.classList.toggle('text-white', active);
            btn.classList.toggle('border-[#222222]', active);
            btn.classList.toggle('shadow-md', active);
            btn.classList.toggle('bg-white', !active);
            btn.classList.toggle('text-[#222222]', !active);
            btn.classList.toggle('border-[#222222]/12', !active);
            const numBadge = btn.querySelector('span');
            if (numBadge) {
              numBadge.classList.toggle('bg-[#f7931e]', active);
              numBadge.classList.toggle('text-[#222222]', active);
              numBadge.classList.toggle('border-[#f7931e]', active);
              numBadge.classList.toggle('bg-[#f7f7f7]', !active);
            }
          });
          if (badgeEl) badgeEl.textContent = step.badge;
          if (pathEl) pathEl.textContent = step.path;
          if (titleEl) titleEl.textContent = step.title;
          if (summaryEl) summaryEl.textContent = step.summary;
          if (termEl) termEl.textContent = step.terminal;
          if (highlightsEl) {
            highlightsEl.innerHTML = step.highlights
              .map(
                (h: string) =>
                  `<li class="flex items-center gap-2.5 text-sm font-medium text-[#222222]"><span class="w-2 h-2 rounded-full bg-[#f7931e] shrink-0"></span><span>${h}</span></li>`
              )
              .join('');
          }
        });
      });
    }

    // 4. Theme Options Live Customizer
    const playground = document.getElementById('v2-theme-playground');
    if (playground && playground.dataset.bound !== 'true') {
      playground.dataset.bound = 'true';
      const accentBtns = Array.from(playground.querySelectorAll<HTMLButtonElement>('[data-theme-accent]'));
      const logoBtns = Array.from(playground.querySelectorAll<HTMLButtonElement>('[data-theme-logo]'));
      const headerToggle = document.getElementById('v2-header-page-toggle') as HTMLInputElement | null;
      const previewCta = document.getElementById('v2-preview-cta');
      const previewLogo = document.getElementById('v2-preview-logo');
      const previewTopbar = document.getElementById('v2-preview-topbar');

      accentBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const color = btn.dataset.themeAccent || '#f7931e';
          accentBtns.forEach((b) => {
            const active = b === btn;
            b.classList.toggle('bg-[#222222]', active);
            b.classList.toggle('text-white', active);
            b.classList.toggle('border-[#222222]', active);
            b.classList.toggle('bg-white', !active);
            b.classList.toggle('text-[#222222]', !active);
          });
          if (previewCta) {
            previewCta.style.backgroundColor = color;
            previewCta.style.color = color === '#f7931e' ? '#222222' : '#ffffff';
          }
          if (previewTopbar) {
            previewTopbar.style.backgroundColor = color;
            previewTopbar.style.color = color === '#f7931e' ? '#222222' : '#ffffff';
          }
        });
      });

      logoBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const sz = btn.dataset.themeLogo || 'md';
          logoBtns.forEach((b) => {
            const active = b === btn;
            b.classList.toggle('bg-[#222222]', active);
            b.classList.toggle('text-white', active);
            b.classList.toggle('border-[#222222]', active);
            b.classList.toggle('bg-white', !active);
            b.classList.toggle('text-[#222222]', !active);
          });
          if (previewLogo) {
            previewLogo.classList.remove('text-xs', 'text-sm', 'text-lg', 'px-2.5', 'px-3', 'px-5');
            if (sz === 'sm') previewLogo.classList.add('text-xs', 'px-2.5');
            else if (sz === 'lg') previewLogo.classList.add('text-lg', 'px-5');
            else previewLogo.classList.add('text-sm', 'px-3');
          }
        });
      });

      headerToggle?.addEventListener('change', () => {
        previewTopbar?.classList.toggle('hidden', !headerToggle.checked);
      });
    }

    // 5. Interactive ROI Savings Calculator
    const slider = document.getElementById('v2-calc-slider') as HTMLInputElement | null;
    const countEl = document.getElementById('v2-calc-count');
    const filesEl = document.getElementById('v2-calc-files');
    const hoursEl = document.getElementById('v2-calc-hours');
    if (slider && slider.dataset.bound !== 'true') {
      slider.dataset.bound = 'true';
      slider.addEventListener('input', () => {
        const n = Number(slider.value || 15);
        if (countEl) countEl.textContent = `${n} Elements`;
        if (filesEl) filesEl.textContent = String(n);
        if (hoursEl) hoursEl.textContent = `${Math.round(n * 4.5)}h`;
      });
    }
  }

  initHomeV2Interactions();

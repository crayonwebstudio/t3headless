---
import { SITE_CONTENT, ROUTES, T3ELEMENT_LINKS, getEquivalentRoute, type Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const content = SITE_CONTENT[locale];
const routes = ROUTES[locale];
const currentPath = Astro.url.pathname;

const enUrl = getEquivalentRoute(currentPath, 'en');
const deUrl = getEquivalentRoute(currentPath, 'de');
---

<header class="w-full hairline-b bg-white/95 backdrop-blur-md sticky top-0 z-40">
  <div class="swiss-container py-4">
    <div class="flex items-center justify-between gap-4">
      <!-- Left: Official Logo + 1px Vertical Divider + 2-Line Descriptor (T3Element TopHeader style) -->
      <div class="flex items-center gap-5">
        <a href={routes.home} class="group inline-flex items-center focus:outline-none shrink-0" aria-label="T3Headless Home">
          <img
            src="/images/logo/t3headless-color.png"
            alt="t3headless"
            width="160"
            height="40"
            class="h-7 sm:h-8 w-auto object-contain transition-transform duration-200 group-hover:scale-[1.02]"
          />
        </a>

        <span class="hidden md:inline-block h-7 w-[1px] bg-[#222222]/25 shrink-0" aria-hidden="true"></span>

        <p class="hidden md:block text-[0.78rem] leading-[1.3] text-[#4e4e4e] m-0">
          Enterprise Headless CMS<br />
          {locale === 'de' ? 'Lösung für TYPO3' : 'Solution for TYPO3'}
        </p>
      </div>

      <!-- Right: Live Clock with Orange Dot + EN/DE Switcher + Outlined Pill CTA -->
      <div class="flex items-center gap-4 sm:gap-6">
        <div class="hidden lg:flex items-center gap-2 text-[0.82rem] text-[#4e4e4e] tabular-nums" title="Zurich / Opfikon HQ Time">
          <span class="w-1.5 h-1.5 rounded-full bg-[#f7931e] shrink-0" aria-hidden="true"></span>
          <span id="uxis-live-clock" class="font-medium">--:-- --</span>
          <span class="text-[#8c8c8c]">• CH</span>
        </div>

        <!-- Language Switcher -->
        <div class="inline-flex items-center rounded-full border border-[#d9d9d9] bg-white p-0.5 text-xs font-mono">
          <a
            href={enUrl}
            class:list={[
              'px-2.5 py-1 rounded-full transition-colors font-semibold',
              locale === 'en' ? 'bg-[#222222] text-white' : 'text-[#4e4e4e] hover:text-[#222222]',
            ]}
          >
            EN
          </a>
          <a
            href={deUrl}
            class:list={[
              'px-2.5 py-1 rounded-full transition-colors font-semibold',
              locale === 'de' ? 'bg-[#222222] text-white' : 'text-[#4e4e4e] hover:text-[#222222]',
            ]}
          >
            DE
          </a>
        </div>

        <a
          href={T3ELEMENT_LINKS.siteUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1 text-sm font-semibold text-[#222222] uxis-underline"
        >
          <span>T3Element</span>
          <span aria-hidden="true" class="text-xs">↗</span>
        </a>

        <a href={routes.document} class="hidden sm:inline-block text-sm font-semibold text-[#222222] uxis-underline">
          {content.nav.document}
        </a>

        <a
          href={routes.contact}
          class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[#222222] text-[0.82rem] font-semibold text-[#222222] hover:bg-[#222222] hover:text-white transition-all"
        >
          <span>{content.hero.primaryCta}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  function updateSwissClock() {
    const el = document.getElementById('uxis-live-clock');
    if (!el) return;
    try {
      const now = new Date();
      const timeFormatter = new Intl.DateTimeFormat('en-US', {
        timeZone: 'Europe/Zurich',
        hour: '2-digit',
        minute: '2-digit',
        hour12: true,
      });
      const dateFormatter = new Intl.DateTimeFormat('en-US', {
        timeZone: 'Europe/Zurich',
        month: 'short',
        day: 'numeric',
      });
      el.textContent = `${timeFormatter.format(now)} · ${dateFormatter.format(now)}`;
    } catch {
      el.textContent = 'Zurich, CH';
    }
  }
  updateSwissClock();
  setInterval(updateSwissClock, 30000);
  document.addEventListener('astro:page-load', updateSwissClock);
</script>
